      "position": [
        208,
        880
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst since = $now.minus({ days: 7 });\nconst inWeek = (d) => d && DateTime.fromISO(String(d)) >= since;\nconst created = rows.filter(r => inWeek(r.createdAt));\nconst contacted = rows.filter(r => inWeek(r.last_contacted_at));\nconst replied = rows.filter(r => r.reply_category && inWeek(r.updatedAt));\nconst interested = replied.filter(r => r.reply_category === \"interested\");\nconst booked = rows.filter(r => inWeek(r.meeting_time) || (r.stage === \"Meeting booked\" && inWeek(r.updatedAt)));\nconst sent = rows.filter(r => inWeek(r.proposal_sent_at));\nconst won = rows.filter(r => r.stage === \"Won\" && inWeek(r.updatedAt));\nconst lost = rows.filter(r => r.stage === \"Lost\" && inWeek(r.updatedAt));\nconst avg = created.length ? Math.round(created.reduce((s, r) => s + (r.fit_score || 0), 0) / created.length) : 0;\nconst open = rows.filter(r => [\"Interested\", \"Meeting booked\", \"Proposal needed\", \"Proposal sent\"].includes(r.stage)).length;\nreturn [{ json: { prospects_added: created.length, avg_fit: avg, emails_contacted: contacted.length, replies: replied.length, reply_rate: contacted.length ? Math.round(100 * replied.length / contacted.length) : 0, interested: interested.length, meetings: booked.length, proposals_sent: sent.length, won: won.length, lost: lost.length, lost_reasons: lost.map(r => r.lost_reason).filter(Boolean), open_pipeline: open } }];"
      },
      "id": "4f160b52-c8e2-4c3f-83da-c5ce4fa6f4b3",
      "name": "Compute Weekly Numbers",
      "type": "n8n-nodes-base.code",
